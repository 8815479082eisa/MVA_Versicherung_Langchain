
# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UVICORN_RELOAD=false
INIT_PIPELINE_ON_STARTUP=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Data/Storage Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
BENCHMARK_DIR=./data/benchmarks
PDF_DIRECTORY=./data/raw/pdfs
CHROMA_PERSIST_DIRECTORY=./data/processed/vectorstores/chroma_db
AUDIT_LOG_FILE=./data/processed/logs/audit.log
PDF_HASH_FILE=./data/processed/caches/pdf_hashes.json
MODEL_CONFIG_FILE=./data/processed/caches/model_config.json
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://141.41.32.94:41314
OLLAMA_MODEL=qwen3.5:4b

# Local model role mapping (GPU/Ollama)
ANSWER_MODEL=qwen3.5:4b
ROUTER_MODEL=functiongemma:270m
SELF_CHECK_MODEL=lfm2.5-thinking:1.2b
QUERY_REWRITE_MODEL=lfm2.5-thinking:1.2b
COMPRESSOR_MODEL=lfm2.5-thinking:1.2b
EVAL_LLM_MODEL=lfm2.5-thinking:1.2b
# Reserved for a future OCR/scan pipeline; the current PDF flow uses PyPDFLoader directly.
OCR_MODEL=glm-ocr:bf16

# Safety Layer
SAFETY_ENABLED=true
# SAFETY_MODE: enforce|monitor|off
SAFETY_MODE=enforce
# minimale groundedness für unsichere ergebnisse
SAFETY_MIN_GROUNDEDNESS=0.7
SAFETY_BLOCK_PII=true
SAFETY_BLOCK_INJECTION=true
# wenn true, beim fehlschlagen oder zweifelhaften ergebnis, wird der fallback-text zurückgegeben
SAFETY_FAIL_CLOSED=true
SAFETY_FALLBACK_TEXT=I cannot provide a safe, policy-compliant answer for this request. Please rephrase.
# liste von erlaubten emails
SAFETY_PII_ALLOWED_EMAILS=support@company.de,info@company.de
# liste von erlaubten telefonnummern
SAFETY_PII_ALLOWED_PHONE_NUMBERS=1234567890,0987654321
# liste von erlaubten domains
SAFETY_PII_ALLOWED_DOMAINS=company.de,company.com
# liste von erlaubten telefonprefixen
SAFETY_PII_ALLOWED_PHONE_PREFIXES=123,456
SAFETY_BACKEND=nemo
NEMO_CONFIG_PATH=./config/nemo_guardrails
NEMO_CONTEXT_CONFIG_PATH=./config/nemo_guardrails_context
NEMO_OUTPUT_CONFIG_PATH=./config/nemo_guardrails_output
NEMO_INPUT_ENABLED=true
NEMO_CONTEXT_ENABLED=true
NEMO_OUTPUT_ENABLED=true
NEMO_ENFORCE_INPUT=true
NEMO_ENFORCE_OUTPUT=true
NEMO_RUNTIME_TIMEOUT_SECONDS=20




# wenn true, wird die retrieval-pipeline immer ausgeführt
RAG_FORCE_RETRIEVAL=true
EMBEDDING_MODEL=BAAI/bge-m3
# device für die embedding-pipeline
EMBEDDING_DEVICE=cpu
# model für die reranker-pipeline
RERANKER_MODEL=BAAI/bge-reranker-base
# wenn true, wird die reranker-pipeline mit fp16 ausgeführt
RERANKER_USE_FP16=false

USE_INSURANCEQA_DATA=true
INSURANCEQA_RETRIEVAL_MODE=switch
INSURANCEQA_EXACT_MATCH_SHORTCUT=false
FAQ_ONLY=false
FAQ_FIRST=false
FAQ_FILE=./data/benchmarks/qa/insuranceqa/data_insuranceqa_1000.jsonl
FAQ_MIN_SIMILARITY=0.80
