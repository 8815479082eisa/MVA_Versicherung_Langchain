# Optional EspoCRM integration. Copy the required values into the repository
# root .env file, or copy this file to .env.crm and pass it to Docker Compose
# with --env-file. Never commit the populated file.
CRM_ENABLED=false

# Runtime access from the backend container to the EspoCRM service.
ESPOCRM_BASE_URL=http://espocrm
ESPOCRM_API_KEY=
ESPOCRM_REQUEST_TIMEOUT_SECONDS=3
ESPOCRM_MAX_PAGES=10
ESPOCRM_PAGE_SIZE=50

# Host access used by the browser, seed script, smoke test, and benchmark.
ESPOCRM_PUBLIC_URL=http://localhost:8080
ESPOCRM_SEED_BASE_URL=http://localhost:8080
ESPOCRM_HOST_PORT=8080

# One-time setup credentials. Use a dedicated temporary API user for seeding
# and revoke it after the synthetic data has been loaded.
ESPOCRM_SEED_API_KEY=
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=

# MariaDB installation credentials used by Docker Compose.
ESPOCRM_DB_NAME=espocrm
ESPOCRM_DB_USER=espocrm
ESPOCRM_DB_PASSWORD=
ESPOCRM_DB_ROOT_PASSWORD=
