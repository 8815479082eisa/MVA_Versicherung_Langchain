# Local Ollama runtime. These values are non-secret engineering defaults.
# Host-side scripts normally use http://localhost:11434.
# The Docker backend uses the host bridge address below.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Final answer provider. The online mode sends only the final grounded prompt
# to OpenAI; router, guardrails, self-check, rewrite and compression stay local.
ANSWER_PROVIDER=ollama
# To enable online answer generation:
# ANSWER_PROVIDER=openai
# ANSWER_MODEL=gpt-4o-mini
# PREFERRED_ANSWER_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Local model roles.
ANSWER_MODEL=qwen2.5:7b-instruct
ROUTER_MODEL=phi3:mini
GUARDRAIL_MODEL=phi3:mini
SELF_CHECK_MODEL=phi3:mini
# Controlled feature flag. Production behavior keeps the self-check enabled.
# Kept off for the normal runtime path to avoid a second LLM validation call.
SELF_CHECK_ENABLED=false
ANSWER_COMPLETENESS_ENABLED=false
QUERY_REWRITE_MODEL=phi3:mini
COMPRESSOR_MODEL=phi3:mini

# Explicit Ollama num_predict limits.
LLM_MAX_TOKENS_ROUTER=8
LLM_MAX_TOKENS_GUARDRAIL=8
LLM_MAX_TOKENS_SELF_CHECK=8
LLM_MAX_TOKENS_QUERY_REWRITE=64
LLM_MAX_TOKENS_COMPRESSOR=384
# The current reranker is a non-generative cross-encoder; this is reserved for
# a future generative reranker and is not passed to FlagReranker.
LLM_MAX_TOKENS_RERANKER=64
LLM_MAX_TOKENS_ANSWER=384

# Per-stage wall/transport timeouts in seconds.
LLM_TIMEOUT_ROUTER_SECONDS=20
LLM_TIMEOUT_GUARDRAIL_SECONDS=30
LLM_TIMEOUT_SELF_CHECK_SECONDS=30
LLM_TIMEOUT_QUERY_REWRITE_SECONDS=45
LLM_TIMEOUT_COMPRESSOR_SECONDS=60
LLM_TIMEOUT_RERANKER_SECONDS=60
LLM_TIMEOUT_ANSWER_SECONDS=120
RETRIEVAL_TIMEOUT_SECONDS=60
API_REQUEST_TIMEOUT_SECONDS=180

# Retry counts are retries after the first attempt. Timeouts are not retried.
LLM_MAX_RETRIES=1
RETRIEVAL_MAX_RETRIES=1
